# provider-ban-server configuration (all optional - defaults shown)
PORT=7710
HOST=127.0.0.1
DB_PATH=data/banserver.sqlite

# Escalating bans: Nth non-revoked ban within 24h lasts N hours, capped here
BAN_MAX_HOURS=24

COLLECT_INTERVAL_SECS=30
NODES_FILE=/home/ubuntu/golem-vanity-market/vanity-nodes-orchestrator/nodes.json
NODES_URL=https://stone.vanity.market/expose/nodes.json
STONE_PORT_BASE=6200
STONE_PUBLIC_BASE=https://stone.vanity.market/nmpdmxzhrm

# One-time history import (gatherer per-agreement records)
SEED_ESTIMATORS_PATH=/home/ubuntu/golem-vanity-market/vanity-nodes-gatherer/estimators.json

# Default enforcement targets served to the stones when no explicit global
# target is set via the UI/API (keep in sync with the stones' .env)
DEFAULT_EFFICIENCY_TARGET=0.05
DEFAULT_SPEED_TARGET=500000

# Auto-relax: providers with >= AUTO_RELAX_MIN_WORK_24H hashes in 24h at
# >= AUTO_RELAX_EFF_FACTOR x the global efficiency target (and no active ban)
# get targets of global / AUTO_RELAX_DIVISOR until they stop qualifying
AUTO_RELAX_ENABLED=1
AUTO_RELAX_MIN_WORK_24H=100000000000
AUTO_RELAX_EFF_FACTOR=2
AUTO_RELAX_DIVISOR=2

# Hardware + price list scraped from stats.golem.network provider pages
# (a few providers per collector cycle, refreshed every TTL hours)
STATS_HW_ENABLED=1
STATS_HW_TTL_HOURS=12
STATS_HW_PER_CYCLE=8

# Scoring / categorization
EFF_TARGET=0.15
VOLUME_TARGET_HOURS=200
TRUSTED_MIN_HOURS=50
TRUSTED_MIN_SCORE=75
RELIABLE_MIN_SCORE=60
AVERAGE_MIN_SCORE=40
BLACKLIST_BANS_7D=5
NEW_MAX_AGREEMENTS=3

STATS_GOLEM_PROVIDER_URL=https://stats.golem.network/network/provider/
